{
	"name": "doma",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26.13.0 <27"
	},
	"scripts": {
		"dev": "pnpm --filter @doma/web dev",
		"build": "pnpm --filter @doma/web build",
		"preview": "pnpm --filter @doma/web preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter @doma/web test:e2e",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"dropbox:ignore": "node scripts/dropbox-ignore.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"@types/node": "26.6.6"
	}
}
