{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm install:*)",
			"Bash(pnpm check)",
			"Bash(pnpm format)",
			"Bash(pnpm format:check)",
			"Bash(pnpm lint)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm test)",
			"Bash(pnpm test:e2e)",
			"Bash(pnpm build)",
			"Bash(pnpm dropbox:ignore)",
			"Bash(git status)",
			"Bash(git diff:*)",
			"Bash(git log:*)"
		],
		"deny": ["Read(./.env)", "Read(./.env.*)"]
	}
}
